#include <iostream>
using namespace std;

int main()
{
    int arr[8];
    int searchValue;
    bool found = false;

    cout << "Enter 8 numbers: ";

    for (int i = 0; i < 8; i++)
    {
        cin >> arr[i];
    }

    cout << "Enter number to search: ";
    cin >> searchValue;

    for (int i = 0; i < 8; i++)
    {
        if (arr[i] == searchValue)
        {
            cout << "Number found at index " << i;
            found = true;
            break;
        }
    }

    if (!found)
        cout << "Number not found.";

    return 0;
}
