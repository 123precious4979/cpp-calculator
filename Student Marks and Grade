#include <iostream>
using namespace std;

int main()
{
    float marks[5];
    float total = 0;
    float percentage;

    cout << "Enter marks for 5 subjects:\n";

    for (int i = 0; i < 5; i++)
    {
        cin >> marks[i];

        if (marks[i] < 0 || marks[i] > 100)
        {
            cout << "Invalid marks.";
            return 0;
        }

        total += marks[i];
    }

    percentage = total / 5;

    cout << "Total = " << total << endl;
    cout << "Percentage = " << percentage << "%" << endl;

    if (percentage >= 80)
        cout << "Grade = A";
    else if (percentage >= 70)
        cout << "Grade = B";
    else if (percentage >= 60)
        cout << "Grade = C";
    else if (percentage >= 50)
        cout << "Grade = D";
    else
        cout << "Grade = F";

    return 0;
}
